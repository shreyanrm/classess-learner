{
  "name": "wobo-learner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "platform/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "gate": "bash scripts/gates.sh",
    "gate:no-classess": "python3 scripts/gate_no_classess.py",
    "gate:white-label": "python3 scripts/gate_white_label.py",
    "gate:pronouns": "python3 scripts/gate_pronouns.py",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "py:lint": "uvx ruff check services content",
    "py:format": "uvx ruff format services content",
    "py:test": "uv run pytest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.7.3"
  }
}
