# --- Secrets (PUBLIC REPO — never commit any real keys) ---
# Order matters: git uses the LAST matching pattern, so every negation below must
# stay after the broad `.env` rules. Do not append `.env*` anywhere further down.
.env
.env.*
*.local
secrets/
*.pem
*.key
# Non-secret, committed-on-purpose exceptions (documented in DEPLOY.md):
!.env.example
!**/.env.example
!apps/web-pwa/.env.production

# --- Node / Bun ---
node_modules/
.bun/
bun.lockb.bak
dist/
build/
.next/
.expo/
.turbo/
coverage/
*.tsbuildinfo

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.uv/

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp

# --- Local agent/tooling state ---
.claude/settings.local.json

# --- Logs / tmp ---
*.log
.cache/
tmp/
.scratch/

# --- Supabase local (we use the hosted project; keep local artifacts out) ---
supabase/.branches/
supabase/.temp/

# --- Deploy CLI state ---
.vercel

# QA / automation artifacts (Wave 4)
xbrowser/
respdiag/
shots/
.playwright-mcp/
test-results/
playwright-report/

# generated content cache (regenerable; PLEXUS_CACHE_DIR relocates it)
content/cache/

# ad-hoc dev screenshots and renders at the repo root
/*.png
/*.jpeg
/*.jpg
/*.mp4

# local env-flipping helpers
scripts/*-env.sh
