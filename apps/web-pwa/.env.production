# Production build flags — COMMITTED ON PURPOSE, and NON-SECRET only.
# This repo is public: no key, token, JWT or service-role value may ever be added
# here. Secrets live exclusively in the Vercel project environment (Settings →
# Environment Variables), which overrides everything in this file at build time.
#
# In Vercel env, never here:
#   VITE_SUPABASE_ANON_KEY   publishable/anon key only — NEVER the service role
# Never set in production at all:
#   VITE_SUPABASE_DEV_JWT    dev-only RLS shim; its presence in a prod build is a leak
#
# Without this file the production build would fall back to dev defaults (mock
# identity, local-only persistence) and fail OPEN. It must stay committed.

# --- Modes: real brain, real persistence, real auth ---
VITE_LLM_MODE=live
VITE_PERSIST_MODE=live
VITE_DEV_AUTH=false

# --- Brand (the domain swap changes these, and nothing else in code) ---
VITE_APP_NAME=Wobo

# --- Endpoints (public URLs, not secrets) ---
VITE_GATEWAY_URL=https://classess-learner-production.up.railway.app
VITE_SUPABASE_URL=https://keepraxqagzgjrrweryt.supabase.co
