# Web PWA (Vite) environment template. Copy to apps/web-pwa/.env.local and fill.
# Only VITE_-prefixed vars reach the browser bundle — treat every one as PUBLIC.
# NEVER put a secret in any VITE_ var. .env.local is git-ignored; .env.production
# is committed and holds non-secret production flags only.

# --- Modes ---
VITE_LLM_MODE=mock            # mock | live
VITE_PERSIST_MODE=local       # local | live (live => Supabase; localStorage stays the offline cache)
VITE_DEV_AUTH=true            # true => dev-mock identity, no login. MUST be false in production.

# --- Brand (brand-neutral config: the domain swap is one change) ---
VITE_APP_NAME=Wobo            # window title, PWA manifest name, short name
VITE_APP_DESCRIPTION=         # optional; falls back to the built-in tagline
VITE_APP_URL=                 # optional canonical origin, e.g. https://app.example.com.
                              # Unset => no canonical/og:url tags, and shared invite links fall
                              # back to window.location.origin (You screen).

# --- Endpoints ---
# 8081 everywhere: services/gateway/Dockerfile, the root .env.example (GATEWAY_URL) and
# apps/web-pwa/.env.development. Dev command: uv run uvicorn classess_gateway.app:app --port 8081
VITE_GATEWAY_URL=http://localhost:8081
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=       # publishable/anon key ONLY — never the service role
VITE_SUPABASE_DEV_JWT=        # dev-only pre-minted JWT so RLS attributes dev writes. Never in prod.

# Nothing else from the root .env.example belongs here. The gateway's Wave 1 variables —
# SUPABASE_JWT_SECRET / SUPABASE_JWKS_URL, SUPABASE_SERVICE_ROLE_KEY, DEV_AUTH, the
# FREE_/ANON_/PLUS_DAILY_* dials, UNAUTH_RATE_LIMIT_PER_MINUTE, TRUST_PROXY, EMAIL_*,
# APP_NAME/APP_URL/APP_PREVIEW_ORIGIN_REGEX and INTERNAL_EMAIL_KEY — are SERVER-side and live on
# the Railway service only. A VITE_ var is public; putting one of those here would ship it to
# every browser. See DEPLOY.md §0.
